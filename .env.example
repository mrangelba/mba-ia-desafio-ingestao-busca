# Provedor de IA: openai ou google
MODEL_PROVIDER=openai

# OpenAI (usado quando MODEL_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# Google Gemini (usado quando MODEL_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite

# PostgreSQL + pgVector (driver psycopg 3 obrigatório)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=document_chunks

# PDF a ser ingerido
PDF_PATH=document.pdf
